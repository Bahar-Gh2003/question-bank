@page "/admin/manage-exams"
@attribute [Authorize(Roles = "Admin")]
@using System.Globalization
@using System.Net.Http.Json
@using Client.Helpers
@using Shared.Admin
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>مدیریت آزمون‌ها</PageTitle>

<div class="mirror-field">
<MudTabs RightToLeft="true" PanelClass="pa-6" @bind-ActivePanelIndex="_activeTabIndex">
    <MudTabPanel Text="تعریف آزمون جدید">
        <div class="">
        <MudPaper Class="pa-4">
            <MudTextField Label="عنوان آزمون" @bind-Value="_createExamDto.Title" Variant="Variant.Outlined"/>

            <MudSelect T="Guid?" @bind-Value="_createExamDto.LevelId" Label=" سطح آزمون" Variant="Variant.Outlined" Class="mt-4">
                @if (_levels != null)
                {
                    @foreach (var level in _levels)
                    {
                        <MudSelectItem T="Guid?" Value="@level.Id">@level.Title</MudSelectItem>
                    }
                }
            </MudSelect>

            <MudNumericField Label="مدت زمان (دقیقه)" @bind-Value="_createExamDto.DurationInMinutes" Variant="Variant.Outlined" Class="mt-4" Min="1" Max="600"/>
            <MudNumericField Label="حداقل نمره قبولی" @bind-Value="_createExamDto.PassingScore" Variant="Variant.Outlined" Class="mt-4" Min="0"/>

            <MudNumericField Label="تعداد سوالات آزمون"
                             @bind-Value="_createExamDto.QuestionCount"
                             Variant="Variant.Outlined" Class="mt-4"
                             Min="1" Max="200"
                             HelperText="سوالات به صورت تصادفی از سوالات همین سطح انتخاب می‌شوند و برای هر تلاش، مجموعه جدیدی انتخاب می‌شود."
                             HelperTextOnFocus="false"/>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="HandleCreateExam" Disabled="@_isSaving">
                ایجاد آزمون
            </MudButton>
        </MudPaper>
        </div>
    </MudTabPanel>
    <MudTabPanel Text="لیست آزمون‌های تعریف شده">
        <div class="mirror-field">
        @if (_allExams == null)
        {
            <MudProgressCircular Indeterminate="true"/>
        }
        else
        {
            <MudTable Items="@_allExams" Hover="true" Striped="true"
                      Style="width:100%" TableLayout="TableLayout.Fixed">
                <HeaderContent>
                    <MudTh Style="width:22%">عنوان آزمون</MudTh>
                    <MudTh Style="width:18%">سطح</MudTh>
                    <MudTh Style="width:15%">مدت</MudTh>
                    <MudTh Style="width:25%">تعداد سوالات</MudTh>
                    <MudTh Style="width:20%">عملیات</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="عنوان">@context.Title</MudTd>
                    <MudTd DataLabel="سطح">@context.LevelTitle</MudTd>
                    <MudTd DataLabel="مدت">@context.DurationInMinutes.ToPersianDigits() دقیقه </MudTd>
                    <MudTd DataLabel="تعداد سوالات">
                        @context.QuestionCount.ToPersianDigits() از @context.AvailableQuestionCount.ToPersianDigits()
                        @if (context.AvailableQuestionCount < context.QuestionCount)
                        {
                            <MudTooltip Text="سوالات این سطح برای اجرای آزمون کافی نیست">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" Class="ml-1"/>
                            </MudTooltip>
                        }
                    </MudTd>
                    <MudTd DataLabel="عملیات">
                        <MudTooltip Text="مشاهده نتایج">
                            <MudIconButton Href="@($"/admin/exam-results/{context.Id}")" Icon="@Icons.Material.Filled.Leaderboard" Color="Color.Info" Size="Size.Small"/>
                        </MudTooltip>
                        <MudTooltip Text="ویرایش آزمون">
                            <MudIconButton Href="@($"/admin/edit-exam/{context.Id}")" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" Class="ml-2"/>
                        </MudTooltip>
                        <MudTooltip Text="حذف آزمون">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => ConfirmDelete(context.Id, context.Title))" Class="ml-2"/>
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        </div>
    </MudTabPanel>
</MudTabs>

</div>

@code {
    private CreateExamDto _createExamDto = new();
    private List<LevelDto>? _levels;

    [Parameter, SupplyParameterFromQuery]
    public string? Tab { get; set; }

    private int _activeTabIndex = 0;
    private bool _isSaving;

    private List<AdminExamListDto>? _allExams;

    protected override async Task OnInitializedAsync()
    {
        if (Tab?.ToLower() == "list")
        {
            _activeTabIndex = 1; // Switch to the exam list tab
        }
        await Task.WhenAll(LoadLevels(), LoadAllExams());
    }

    private async Task LoadLevels()
    {
        _levels = await Http.GetFromJsonAsync<List<LevelDto>>("api/Levels");
    }

    private async Task LoadAllExams()
    {
        _allExams = await Http.GetFromJsonAsync<List<AdminExamListDto>>($"api/Exams?cacheBuster={Guid.NewGuid()}");
        StateHasChanged();
    }

    private async Task ConfirmDelete(Guid examId, string title)
    {
        var result = await DialogService.ShowMessageBox("تایید حذف", $"آیا از حذف آزمون «{title}» مطمئن هستید؟", yesText: "حذف", cancelText: "لغو");
        if (result == true)
        {
            var response = await Http.DeleteAsync($"api/Exams/{examId}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("آزمون با موفقیت حذف شد.", Severity.Success);
                await LoadAllExams();
            }
            else
            {
                // Read and display the specific error message returned by the API
                Snackbar.Add(await ReadErrorMessageAsync(response, "خطا در حذف آزمون."), Severity.Error);
            }
        }
    }

    private async Task HandleCreateExam()
    {
        if (!_createExamDto.LevelId.HasValue)
        {
            Snackbar.Add("لطفاً سطح آزمون را انتخاب کنید.", Severity.Warning);
            return;
        }

        if (_createExamDto.QuestionCount < 1)
        {
            Snackbar.Add("تعداد سوالات آزمون باید حداقل ۱ باشد.", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/Exams", _createExamDto);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("آزمون با موفقیت ایجاد شد.", Severity.Success);
                _createExamDto = new();
                await LoadAllExams();
            }
            else
            {
                // The server explains exactly what went wrong (e.g. not enough questions in this level)
                Snackbar.Add(await ReadErrorMessageAsync(response, "خطا در ایجاد آزمون."), Severity.Error);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage response, string fallback)
    {
        try
        {
            var problem = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            return string.IsNullOrWhiteSpace(problem?.Message) ? fallback : problem.Message;
        }
        catch
        {
            return fallback;
        }
    }

    private class ErrorResponse
    {
        public string? Message { get; set; }
    }
}