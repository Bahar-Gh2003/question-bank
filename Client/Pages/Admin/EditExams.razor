@page "/admin/edit-exam/{ExamId:guid}"
@attribute [Authorize(Roles = "Admin")]
@using System.Globalization
@using System.Net.Http.Json
@using Shared.Admin
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>ویرایش آزمون</PageTitle>
<MudText Typo="Typo.h4" GutterBottom="true">ویرایش آزمون</MudText>

@if (_updateExamDto == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-6 mt-4">
        <div class="mirror-field">
        <MudTextField Label="عنوان آزمون" @bind-Value="_updateExamDto.Title" Variant="Variant.Outlined"/>

        <MudSelect T="Guid" @bind-Value="_updateExamDto.LevelId" Label="برای سطح" Variant="Variant.Outlined" Class="mt-4">
            @if (_levels != null)
            {
                @foreach (var level in _levels)
                {
                    <MudSelectItem Value="@level.Id">@level.Title</MudSelectItem>
                }
            }
        </MudSelect>

        <MudNumericField Label="مدت زمان (دقیقه)" @bind-Value="_updateExamDto.DurationInMinutes" Variant="Variant.Outlined" Class="mt-4" Min="1" Max="600"/>
        <MudNumericField Label="حداقل نمره قبولی" @bind-Value="_updateExamDto.PassingScore" Variant="Variant.Outlined" Class="mt-4" Min="0"/>

        <MudNumericField Label="تعداد سوالات آزمون"
                         @bind-Value="_updateExamDto.QuestionCount"
                         Variant="Variant.Outlined" Class="mt-4"
                         Min="1" Max="200"
                         HelperText="سوالات به صورت تصادفی از سوالات همین سطح انتخاب می‌شوند."
                         HelperTextOnFocus="false"/>

        <div class="d-flex justify-space-between mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleUpdateExam" Disabled="@_isSaving">
                ذخیره تغییرات
            </MudButton>
            <MudButton Href="/admin/manage-exams?tab=list" Variant="Variant.Outlined">بازگشت</MudButton>
        </div>
        </div>
    </MudPaper>
}

@code {
    [Parameter] public Guid ExamId { get; set; }

    private UpdateExamDto? _updateExamDto;
    private List<LevelDto>? _levels;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        _updateExamDto = await Http.GetFromJsonAsync<UpdateExamDto>($"api/Exams/{ExamId}");
        _levels = await Http.GetFromJsonAsync<List<LevelDto>>("api/Levels");
    }

    private async Task HandleUpdateExam()
    {
        if (_updateExamDto == null) return;

        if (_updateExamDto.QuestionCount < 1)
        {
            Snackbar.Add("تعداد سوالات آزمون باید حداقل ۱ باشد.", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/Exams/{ExamId}", _updateExamDto);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("آزمون با موفقیت بروزرسانی شد.", Severity.Success);
                NavigationManager.NavigateTo("/admin/manage-exams?tab=list");
            }
            else
            {
                // Previously the response was ignored and a success message was always shown
                Snackbar.Add(await ReadErrorMessageAsync(response, "خطا در بروزرسانی آزمون."), Severity.Error);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage response, string fallback)
    {
        try
        {
            var problem = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            return string.IsNullOrWhiteSpace(problem?.Message) ? fallback : problem.Message;
        }
        catch
        {
            return fallback;
        }
    }

    private class ErrorResponse
    {
        public string? Message { get; set; }
    }
}