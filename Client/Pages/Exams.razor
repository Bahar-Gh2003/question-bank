@page "/exams"

@attribute [Authorize(Roles = "Student")]

@using System.Globalization

@using Microsoft.AspNetCore.Authorization
@using Shared.Student
@using Client.Helpers


@inject HttpClient Http

@inject NavigationManager NavigationManager





<PageTitle>آزمون‌های شما</PageTitle>



<MudText Typo="Typo.h4" GutterBottom="true">لیست آزمون‌ها</MudText>
@* <PageHeader Title="لیست آزمون ها" /> *@



@if (_exams == null)

{

<MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />

}

else if (!_exams.Any())

{

<MudAlert Severity="Severity.Info" Class="mt-4">در حال حاضر آزمونی برای سطح شما وجود ندارد.</MudAlert>

}

else

{

<MudGrid Spacing="3" Class="mt-4">

@foreach (var exam in _exams)

{

<MudItem xs="12" sm="6" md="4">

<MudCard Elevation="3">

<MudCardHeader Class="d-flex flex-column align-center">

<CardHeaderContent>

<MudText Typo="Typo.h6">@exam.Title</MudText>

<MudText Typo="Typo.body2"> @exam.LevelTitle</MudText>

</CardHeaderContent>

</MudCardHeader>

<MudCardContent Class="d-flex flex-column align-center">

@* <MudText><b>زمان شروع:</b> @ToPersianDateTimeString(exam.StartTime)</MudText> *@

<MudText><b>مدت زمان:</b> @(exam.DurationInMinutes.ToPersianDigits()) دقیقه</MudText>

<div class="mt-2">

<MudChip T="string" Color="@GetStatusColor(exam.Status)">@GetStatusText(exam)</MudChip>

</div>

</MudCardContent>

<MudCardActions Class="d-flex flex-column align-center">

<MudButton Variant="Variant.Filled"

Color="Color.Primary"

OnClick="@(() => StartExam(exam.ExamId))"

Disabled="@(!exam.Status.Contains("آماده"))">

    @GetButtonText(exam.Status)
    </MudButton>

</MudCardActions>

</MudCard>

</MudItem>

}

</MudGrid>

}



@code {

private List<ExamListDto>? _exams;



protected override async Task OnInitializedAsync()

{

_exams = await Http.GetFromJsonAsync<List<ExamListDto>>("api/Student/exams");

}



private string ToPersianDateTimeString(DateTime? utcDateTime)

{

if (!utcDateTime.HasValue) return "";


var localDateTime = utcDateTime.Value; // Remove .ToLocalTime()

var persianCalendar = new PersianCalendar();


var year = persianCalendar.GetYear(localDateTime);

var month = persianCalendar.GetMonth(localDateTime).ToString("00");

var day = persianCalendar.GetDayOfMonth(localDateTime).ToString("00");

var time = localDateTime.ToString("HH:mm");



return $"{time} - {year}/{month}/{day}".ToPersianDigits();

}


// متد جدید برای نمایش متن وضعیت

    private string GetStatusText(ExamListDto exam)
    {
        if (exam.Status == "قفل")
        {
            return $"فعال در {ToPersianDateTimeString(exam.NextAttemptAvailableAt)}";
        }
        return exam.Status;
    }
    private string GetButtonText(string status)
    {
        if (status.Contains("مجدد"))
        {
            return "شروع تلاش مجدد";
        }
        return "شروع آزمون";
    }

    private Color GetStatusColor(string status)
    {
        if (status.Contains("آماده")) return Color.Default;
        if (status.Contains("قبول")) return Color.Primary;
        if (status.Contains("قفل"))  return Color.Default;
        if (status.Contains("تمام شده") || status.Contains("مردود")) return Color.Error;
        return Color.Default;
    }



private void StartExam(Guid examId)

{

NavigationManager.NavigateTo($"/take-exam/{examId}");

}

    
}