@page "/take-exam/{ExamId:guid}"
@attribute [Authorize(Roles = "Student")]
@using System.Timers
@using System.Net.Http.Json
@using Client.Helpers
@using Domain
@using Shared.Student
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>شرکت در آزمون</PageTitle>

@if (_isLoading)
{
    <MudText>در حال آماده‌سازی آزمون...</MudText>
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_loadError</MudAlert>
    <MudButton Variant="Variant.Filled" Class="mt-4" OnClick="@(() => NavigationManager.NavigateTo("/exams"))">
        بازگشت به لیست آزمون‌ها
    </MudButton>
}
else if (_examSession is not null)
{
    var currentQuestion = _examSession.Questions[_currentQuestionIndex];

    <div class="d-flex justify-space-between align-center">
        <MudText Typo="Typo.h4">@_examSession.ExamTitle</MudText>
        <MudChip T="string" Color="Color.Error" Variant="Variant.Text" Size="Size.Large">@_timeRemainingDisplay</MudChip>
    </div>

    <MudText Typo="Typo.h6" Class="mt-4">
        سوال @((_currentQuestionIndex + 1).ToPersianDigits()) از @_examSession.Questions.Count.ToPersianDigits()
    </MudText>

    <MudPaper Elevation="3" Class="pa-4 mt-4">
        @if (!string.IsNullOrEmpty(currentQuestion.ImageUrl))
        {
            <div class="d-flex justify-center mb-4">
                <img src="@(ApiBaseUrl + currentQuestion.ImageUrl)" style="max-height: 200px; max-width: 100%;" />
            </div>
        }
        <MudText>@currentQuestion.Content</MudText>
    </MudPaper>

    @if (currentQuestion.Type == QuestionType.MultipleChoice)
    {
        <MudRadioGroup T="Guid?"
                       @key="currentQuestion.QuestionId"
                       ValueChanged="OnAnswerSelected"
                       Value="@currentQuestion.SelectedOptionId"
                       Disabled="@(currentQuestion.IsLocked || _isCheckingAnswer)"
                       Class="vertical-radio-group">
            @foreach (var option in currentQuestion.Options)
            {
                <MudRadio T="Guid?" Value="@option.Id">@option.Content</MudRadio>
            }
        </MudRadioGroup>
    }
    else
    {
        <div class="mirror-field">
            <MudTextField @bind-Value="@_shortAnswerTexts[currentQuestion.QuestionId]"
                          Label="پاسخ خود را اینجا وارد کنید"
                          Variant="Variant.Outlined" Lines="3" Class="mt-4" />
        </div>
    }

    @if (!string.IsNullOrEmpty(_feedbackMessage))
    {
        <MudAlert Severity="@_feedbackSeverity" Class="mt-4">@_feedbackMessage</MudAlert>
    }

    <div class="d-flex justify-space-between mt-6 mirror-field">
        @if (_currentQuestionIndex < _examSession.Questions.Count - 1)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NextQuestion">سوال بعد</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="FinishExam" Disabled="@_isSubmitting">
                پایان آزمون
            </MudButton>
        }
        <MudButton Variant="Variant.Filled" OnClick="PreviousQuestion" Disabled="@(_currentQuestionIndex == 0)">
            سوال قبل
        </MudButton>
    </div>
}

@code {
    [Parameter] public Guid ExamId { get; set; }

    // TODO: این باید از appsettings کلاینت خوانده شود، نه hardcode
    private string ApiBaseUrl => Http.BaseAddress!.ToString().TrimEnd('/');
    private ExamSessionDto? _examSession;
    private string? _loadError;
    private int _currentQuestionIndex;

    private readonly Dictionary<Guid, string> _shortAnswerTexts = new();

    private string? _feedbackMessage;
    private Severity _feedbackSeverity = Severity.Normal;

    private bool _isSubmitting;
    private bool _isCheckingAnswer;
    private bool _isLoading = true;

    private Timer? _timer;
    private string _timeRemainingDisplay = "00:00";
    private TimeSpan _timeRemaining;

    protected override async Task OnInitializedAsync()
    {
        // سرور جلسه را می‌سازد (یا اگر جلسه بازی هست، همان را برمی‌گرداند)
        var response = await Http.PostAsync($"api/student/start-exam/{ExamId}", null);

        if (!response.IsSuccessStatusCode)
        {
            _loadError = await ReadErrorMessageAsync(response, "امکان شروع این آزمون وجود ندارد.");
            _isLoading = false;
            return;
        }

        _examSession = await response.Content.ReadFromJsonAsync<ExamSessionDto>();

        if (_examSession is null || _examSession.Questions.Count == 0)
        {
            _loadError = "سوالی برای این آزمون یافت نشد.";
            _isLoading = false;
            return;
        }

        foreach (var q in _examSession.Questions.Where(q => q.Type == QuestionType.ShortAnswer))
        {
            _shortAnswerTexts[q.QuestionId] = q.ShortAnswerText ?? "";
        }

        // زمان باقی‌مانده را سرور تعیین می‌کند، نه مرورگر
        _timeRemaining = TimeSpan.FromSeconds(_examSession.RemainingSeconds);
        _timeRemainingDisplay = _timeRemaining.ToString(@"mm\:ss");
        StartTimer();

        _isLoading = false;
    }

    private async Task OnAnswerSelected(Guid? selectedOptionId)
    {
        if (!selectedOptionId.HasValue || _isCheckingAnswer) return;

        var question = _examSession!.Questions[_currentQuestionIndex];
        if (question.IsLocked) return;

        _isCheckingAnswer = true;
        try
        {
            // تصمیم درست/غلط را سرور می‌گیرد — پاسخ صحیح هرگز به مرورگر نمی‌آید
            var response = await Http.PostAsJsonAsync("api/student/check-answer", new CheckAnswerDto
            {
                AttemptId = _examSession.AttemptId,
                QuestionId = question.QuestionId,
                SelectedOptionId = selectedOptionId.Value
            });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(await ReadErrorMessageAsync(response, "خطا در ثبت پاسخ."), Severity.Error);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<CheckAnswerResultDto>();
            if (result is null) return;

            question.SelectedOptionId = selectedOptionId;
            question.AttemptsUsed = result.AttemptsUsed;
            question.IsLocked = result.IsLocked;

            _feedbackMessage = result.Message;
            _feedbackSeverity = result.IsCorrect
                ? Severity.Success
                : result.IsLocked ? Severity.Error : Severity.Warning;
        }
        finally
        {
            _isCheckingAnswer = false;
            StateHasChanged();
        }
    }

    private void GoToQuestion()
    {
        _feedbackMessage = null;
        StateHasChanged();
    }

    private void NextQuestion()
    {
        if (_currentQuestionIndex < _examSession!.Questions.Count - 1)
        {
            _currentQuestionIndex++;
            GoToQuestion();
        }
    }

    private void PreviousQuestion()
    {
        if (_currentQuestionIndex > 0)
        {
            _currentQuestionIndex--;
            GoToQuestion();
        }
    }

    private async Task FinishExam()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;
        _timer?.Stop();

        var submission = new SubmitExamDto
        {
            AttemptId = _examSession!.AttemptId,
            ShortAnswerTexts = _shortAnswerTexts
        };

        var response = await Http.PostAsJsonAsync("api/student/submit-exam", submission);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<ExamResultDto>();
            if (result is not null)
            {
                NavigationManager.NavigateTo($"/exam-result/{result.IsPassed}/{result.TotalScore}");
                return;
            }
        }

        Snackbar.Add(await ReadErrorMessageAsync(response, "خطا در ثبت نهایی آزمون."), Severity.Error);
        _isSubmitting = false;
    }

    private void StartTimer()
    {
        _timer = new Timer(1000);
        _timer.Elapsed += OnTimerElapsed;
        _timer.Enabled = true;
    }

    private async void OnTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        if (_isSubmitting) return;

        _timeRemaining = _timeRemaining.Subtract(TimeSpan.FromSeconds(1));
        _timeRemainingDisplay = _timeRemaining > TimeSpan.Zero
            ? _timeRemaining.ToString(@"mm\:ss")
            : "00:00";

        if (_timeRemaining.TotalSeconds <= 0)
        {
            _timer?.Stop();
            await InvokeAsync(FinishExam);
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    private static async Task<string> ReadErrorMessageAsync(HttpResponseMessage response, string fallback)
    {
        try
        {
            var problem = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            return string.IsNullOrWhiteSpace(problem?.Message) ? fallback : problem.Message;
        }
        catch
        {
            return fallback;
        }
    }

    private class ErrorResponse
    {
        public string? Message { get; set; }
    }

    public void Dispose() => _timer?.Dispose();
}