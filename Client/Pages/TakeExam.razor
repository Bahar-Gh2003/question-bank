@page "/take-exam/{ExamId:guid}"
@attribute [Authorize(Roles = "Student")]
@using System.Timers
@using System.Net.Http.Json
@using Client.Helpers
@using Domain
@using Sahred.Student
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@implements IDisposable

@* @implements IDisposable *@

<PageTitle>شرکت در آزمون</PageTitle>
@if (_isLoading)
{
    <MudText>در حال آماده‌سازی آزمون...</MudText>
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (_examSession != null)
{
    var currentQuestion = _examSession.Questions[_currentQuestionIndex];

    <div class="d-flex justify-space-between align-center">
        <MudText Typo="Typo.h4">@_examSession.ExamTitle</MudText>
        <MudChip T="string" Color="Color.Error" Variant="Variant.Text" Size="Size.Large">@_timeRemainingDisplay</MudChip>
    </div>
    
    <MudText Typo="Typo.h6" Class="mt-4">سوال @((_currentQuestionIndex + 1).ToPersianDigits()) از @_examSession.Questions.Count.ToPersianDigits()</MudText>
    
    <MudPaper Elevation="3" Class="pa-4 mt-4">
        @* --- This is the corrected image display section --- *@
        @if (!string.IsNullOrEmpty(currentQuestion.ImageUrl))
        {
            <div class="d-flex justify-center mb-4">
                <img src="@(ApiBaseUrl + currentQuestion.ImageUrl + "?t=" + DateTime.Now.Ticks)" style="max-height: 200px; max-width: 100%;" />
            </div>
        }
        <MudText>@currentQuestion.Content</MudText>
    </MudPaper>

    @if (currentQuestion.Type == QuestionType.MultipleChoice)
    {
        <MudRadioGroup T="Guid?"
                       @key="currentQuestion.QuestionId"
                       ValueChanged="OnAnswerSelected"
                       Value="@_multipleChoiceAnswers.GetValueOrDefault(currentQuestion.QuestionId)"
                       Disabled="@IsQuestionLocked(currentQuestion.QuestionId)" Class="vertical-radio-group">
            @foreach (var option in currentQuestion.Options)
            {
                <MudRadio T="Guid?" Value="@option.Id">@option.Content</MudRadio>
            }
        </MudRadioGroup>
    }
    else
    {
        <div class="mirror-field">
        <MudTextField @bind-Value="@_shortAnswerTexts[currentQuestion.QuestionId]" Label="پاسخ خود را اینجا وارد کنید" Variant="Variant.Outlined" Lines="3" Class="mt-4" />
        </div>
    }

    @if (!string.IsNullOrEmpty(_feedbackMessage))
    {
        <MudAlert Severity="@_feedbackSeverity" Class="mt-4">@_feedbackMessage</MudAlert>
    }

    <div class="d-flex justify-space-between mt-6 mirror-field">
        @if (_currentQuestionIndex < _examSession.Questions.Count - 1)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NextQuestion">سوال بعد</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="FinishExam" Disabled="@_isSubmitting">پایان آزمون</MudButton>
        }
        <MudButton Variant="Variant.Filled" OnClick="PreviousQuestion" Disabled="@(_currentQuestionIndex == 0)">سوال قبل</MudButton>

    </div>
}

@code {
    [Parameter] public Guid ExamId { get; set; }

    private ExamSessionDto? _examSession;
    private int _currentQuestionIndex = 0;
    private const string ApiBaseUrl = "https://localhost:7210";

    private Dictionary<Guid, Guid?> _multipleChoiceAnswers = new();
    private Dictionary<Guid, string> _shortAnswerTexts = new();

    private Dictionary<Guid, int> _questionAttempts = new();
    private Dictionary<Guid, bool> _correctlyAnswered = new();

    private string? _feedbackMessage;
    private Severity _feedbackSeverity = Severity.Normal;

    private bool _isSubmitting = false;
    private bool _isLoading = true;
    private Timer? _timer;
    private string _timeRemainingDisplay = "00:00";
    private TimeSpan _timeRemaining;
    // private DateTime _examAbsoluteEndTime;

    protected override async Task OnInitializedAsync()
    {
        _examSession = await Http.GetFromJsonAsync<ExamSessionDto>($"api/student/take-exam/{ExamId}");
        if (_examSession != null && _examSession.Questions.Any())
        {
            foreach (var q in _examSession.Questions.Where(q => q.Type == QuestionType.ShortAnswer))
            {
                _shortAnswerTexts[q.QuestionId] = "";
            }
            _timeRemaining = TimeSpan.FromMinutes(_examSession.DurationInMinutes);
            StartTimer();
        }

        _isLoading = false;
    }

    private void OnAnswerSelected(Guid? selectedOptionId)
    {
        if (!selectedOptionId.HasValue) return;

        var currentQuestion = _examSession.Questions[_currentQuestionIndex];
        var questionId = currentQuestion.QuestionId;

        if (IsQuestionLocked(questionId)) return;

        _multipleChoiceAnswers[questionId] = selectedOptionId;

        var attempts = _questionAttempts.GetValueOrDefault(questionId, 0) + 1;
        _questionAttempts[questionId] = attempts;

        if (selectedOptionId.Value == currentQuestion.CorrectOptionId)
        {
            _feedbackMessage = "آفرین! پاسخ شما صحیح است.";
            _feedbackSeverity = Severity.Success;
            _correctlyAnswered[questionId] = true;
        }
        else
        {
            if (attempts == 1)
            {
                _feedbackMessage = "پاسخ شما صحیح نبود. یک بار دیگر فرصت دارید.";
                _feedbackSeverity = Severity.Warning;
            }
            else
            {
                _feedbackMessage = "پاسخ شما صحیح نبود. این سوال قفل شد.";
                _feedbackSeverity = Severity.Error;
            }
        }

        StateHasChanged();
    }

    private bool IsQuestionLocked(Guid questionId)
    {
        return _correctlyAnswered.ContainsKey(questionId) || _questionAttempts.GetValueOrDefault(questionId, 0) >= 2;
    }

    private void GoToQuestion()
    {
        _feedbackMessage = null;
        StateHasChanged();
    }

    private void NextQuestion()
    {
        if (_currentQuestionIndex < _examSession.Questions.Count - 1)
        {
            _currentQuestionIndex++;
            GoToQuestion();
        }
    }

    private void PreviousQuestion()
    {
        if (_currentQuestionIndex > 0)
        {
            _currentQuestionIndex--;
            GoToQuestion();
        }
    }

    private async Task FinishExam()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;
        _timer?.Stop();
        // SaveCurrentAnswer();

        var submission = new SubmitExamDto
        {
            ExamId = this.ExamId,
            MultipleChoiceAnswers = _multipleChoiceAnswers,
            ShortAnswerTexts = _shortAnswerTexts
        };
        var response = await Http.PostAsJsonAsync("api/student/submit-exam", submission);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<ExamResultDto>();
            if (result != null)
            {
                NavigationManager.NavigateTo($"/exam-result/{result.IsPassed}/{result.TotalScore}");
            }
        }
        else
        {
            Snackbar.Add("خطا در ثبت نهایی آزمون.", Severity.Error);
            _isSubmitting = false;
        }
    }

    private void StartTimer()
    {
        _timer = new Timer(1000);
        _timer.Elapsed += OnTimerElapsed;
        _timer.Enabled = true;
    }

    private async void OnTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        if (_isSubmitting) return;
        _timeRemaining = _timeRemaining.Subtract(TimeSpan.FromSeconds(1));
        _timeRemainingDisplay = _timeRemaining.ToString(@"mm\:ss");
        if (_timeRemaining.TotalSeconds <= 0)
        {
            _timer?.Stop();
            await InvokeAsync(FinishExam);
        }

        await InvokeAsync(StateHasChanged);
        }
        //
        public void Dispose()
        {
        _timer?.Dispose();
        }
    }

