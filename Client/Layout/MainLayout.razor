@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Authorization
@using Sahred.Student
@inherits LayoutComponentBase
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@using Client.Auth


<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    
    <MudAppBar Anchor="Anchor.Right"  Elevation="1" Class="vazir">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())"/>
        <MudSpacer/>
        @* --- دکمه MudButton قدیمی را با این بلوک جایگزین کنید --- *@
        <AuthorizeView>
            <NotAuthorized>
                <MudButton Href="/login" Color="Color.Inherit">ورود / ثبت‌نام</MudButton>
            </NotAuthorized>
            <Authorized>
                <MudText> @context.User.Identity?.Name</MudText>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        @* <MudAvatar Image="@GetProfilePictureUrl(context.User)" Class="mx-2" Style="cursor: pointer;" /> *@
                        <MudIconButton  Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" />
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Href="/profile">مشاهده پروفایل</MudMenuItem>
                        <MudMenuItem OnClick="Logout">خروج از حساب</MudMenuItem>
                    </ChildContent>
                </MudMenu>
                @* <MudText> @context.User.Identity?.Name</MudText> *@
                @* <MudTooltip Text="پروفایل"> *@
                @*     <MudIconButton Href="/profile" Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" /> *@
                @* </MudTooltip> *@
                @* <MudTooltip Text="خروج"> *@
                @*     <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" /> *@
                @* </MudTooltip> *@
            </Authorized>
        </AuthorizeView>
        @* <MudSpacer/> *@
        @* <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" /> *@
        @* <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())"/> *@
    </MudAppBar>
    

    <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Right"  Elevation="2">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6" >بانک سوالات</MudText>
        </MudDrawerHeader>
        <NavMenu/>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="my-4 pt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>



@code {
    private bool _drawerOpen = true;
    private const string ApiBaseUrl = "https://localhost:7210";
    private MudTheme _theme = new MudTheme();
    private ProfileDto? _profile;
    protected override void OnInitialized()
    {
        // Set the font family after the theme is created
        _theme.Typography.Default.FontFamily = new[] { "Vazirmatn", "sans-serif" };
        _theme.Typography.Button.FontFamily = new[] { "Vazirmatn", "sans-serif" };
    }
    
    

        
    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
    
    private string GetProfilePictureUrl(ClaimsPrincipal user)
    {
        var pictureUrl = user.Claims.FirstOrDefault(c => c.Type == "picture").Value;
        

        if (!string.IsNullOrEmpty(pictureUrl))
        {
            return ApiBaseUrl + pictureUrl;
        }
        return "images/default-avatar.png"; 
    }
    
    private async Task Logout()
    {
        // حذف توکن از حافظه
        await LocalStorage.RemoveItemAsync("authToken");
    
        // اطلاع به برنامه که کاربر خارج شده است
        ((CustomAuthStateProvider)AuthStateProvider).NotifyUserLogout();
        
        // هدایت کاربر به صفحه اصلی
        NavigationManager.NavigateTo("/");
    }
}